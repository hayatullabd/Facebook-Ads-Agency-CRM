ENVIRONMENT=development
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=facebook_ads_crm
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
ALLOW_PUBLIC_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=180
FACEBOOK_TOKEN_ENCRYPTION_KEY=replace-with-a-random-secret-used-only-for-token-encryption
FACEBOOK_GRAPH_VERSION=v20.0
FACEBOOK_REQUEST_TIMEOUT_SECONDS=15
FACEBOOK_SYNC_MAX_PAGES=50
REDIS_URL=redis://localhost:6379/0
PRODUCTION_DOCS_ENABLED=false
SYNC_RETENTION_DAYS=90
