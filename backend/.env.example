NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://username:password@host:27017/database
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
# Required in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=
# Production automatically uses mongo; memory is development-only.
RATE_LIMIT_STORE=memory
SERVE_FRONTEND=false
# Production provisioning (run create:platform-admin with secure one-time values)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
TRUST_PROXY=false
FACEBOOK_REQUEST_TIMEOUT_MS=15000
FACEBOOK_GRAPH_VERSION=v20.0
FACEBOOK_USD_RATES={"BDT":0.0082,"INR":0.012,"EUR":1.09}
FACEBOOK_SYNC_MAX_PAGES=50
FACEBOOK_SYNC_CONCURRENCY=2
FACEBOOK_SYNC_LEASE_MS=120000
FACEBOOK_SYNC_WORKER_POLL_MS=2000
FACEBOOK_SYNC_RETENTION_DAYS=90
SHUTDOWN_TIMEOUT_MS=10000
SEED_ADMIN_PASSWORD=replace-with-a-unique-policy-compliant-password
SEED_TEAM_PASSWORD=replace-with-a-unique-policy-compliant-password
SEED_MODERATOR_PASSWORD=replace-with-a-unique-policy-compliant-password
SEED_CLIENT_PASSWORD=replace-with-a-unique-policy-compliant-password
